# Copy this file to .env.local and fill in the two values below.
# See SETUP.md for where to get them. Never commit .env.local.

# Supabase — Project Settings -> Data API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Everything below this line is NOT read from .env.local.
# These are Supabase Edge Function secrets (see SETUP.md § 4) and are
# listed here only so it's obvious, in one place, which vars exist project-wide.
#
# SUPABASE_SERVICE_ROLE_KEY  -> set via: npx supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
# GROQ_API_KEY               -> set via: npx supabase secrets set GROQ_API_KEY=...
# OPENROUTER_API_KEY         -> set via: npx supabase secrets set OPENROUTER_API_KEY=...
#
# Model names are also env-configurable so a provider/model swap never touches code:
# AI_VISION_MODEL     (Groq)       default: meta-llama/llama-4-scout-17b-16e-instruct
# AI_REASONING_MODEL  (OpenRouter) default: pick a :free-suffixed model at build time
